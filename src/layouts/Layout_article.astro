---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import { getPublicImageDimensions } from '../utils/imageDimensions';

export interface Props {
	title: string;
	h1?: string;
	description: string;
	keywords?: string;
	section?: string;
	section_url?: string;
	url?: string;
	img?: string;
}

const { title, h1, description, section, section_url, url, img } = Astro.props;
const isSectionIndex = Boolean(section_url && !url);
const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://timestable.ru');
const heroSource = section_url && img ? `/images/${section_url}/${img}` : undefined;
const heroDimensions = heroSource ? getPublicImageDimensions(heroSource) : undefined;
---

<!DOCTYPE html>
<html lang="ru">
<head>
	<SeoHead title={title} description={description} />
</head>

<body>

<Header/>

<main class="articlewrap"><article>

{h1 && <h1  class="fullwidtharticle">{h1}</h1>}

{heroSource && <p class="fullwidtharticle"><img src={heroSource} alt={title} width={heroDimensions?.width} height={heroDimensions?.height} fetchpriority="high" decoding="async" /></p>}

<slot />

<nav aria-label="Хлебные крошки" itemscope itemtype="https://schema.org/BreadcrumbList" class="breadcrumbs">
	<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
		<a itemprop="item" href="/">
			<span itemprop="name">Главная</span>
		</a>
		<meta itemprop="position" content="1" />
	</span>

	{section_url && !isSectionIndex &&
		<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
			→
			<a itemprop="item" href={`/${section_url}/`}>
				<span itemprop="name">{section}</span>
			</a>
			<meta itemprop="position" content="2" />
		</span>
	}
	
	{section_url && isSectionIndex &&
		<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
			→ <span itemprop="name">{section}</span>
			<meta itemprop="item" content={currentUrl.href} />
			<meta itemprop="position" content="2" />
		</span>
	}

	{section_url && url &&
		<span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
			→ <span itemprop="name">{title}</span>
			<meta itemprop="item" content={currentUrl.href} />
			<meta itemprop="position" content="3" />
		</span>
	}
</nav>

</article></main>
<Footer />

</body>
</html>
