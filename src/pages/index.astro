<style is:inline>
	.cf:before, .cf:after { content: " "; display: table;}
	.cf:after {  clear: both;}
	.tablecontainer {box-sizing:border-box;  max-width:1200px;  margin: 0 auto;  text-align: center;}
	.mt-heading {  margin: 0px 0px;  font-size: 2.5em;}
	.mt-table {  margin: 0 auto; box-shadow: 0 10px 80px rgba(110, 130, 150, 0.5);   border-radius: 10px;   overflow: hidden; width:94%; max-width:1200px; border-collapse: collapse;}
	.mt-tcell {  padding: 5px 12px; line-height:100%;  font-size: 12px; border:1px solid rgba(0,0,0,0.05); -webkit-transition: all .1s ease-in; transition: all .1s ease-in; cursor:pointer;}
	.mt-result-wrap {  margin: 20px 0;  min-height:40px;}
	.mt-result-wrap span { font-size: 20px; font-weight:700; color:#204ce8;}
	.mt-results {  padding: 0 0 0 5px;  text-align: left;  display:inline-block;  box-sizing:border-box;}
	.is-zone {  background-color: rgba(255, 0, 0, 0.05);}
	.is-zone-border {  background-color: rgba(255, 0, 0, 0.1);}
	.is-square {  background-color: rgb(32 136 232 / 80%); color:white; }
	.is-result, .is-data {  background-color: rgba(255, 0, 0, 0.8); color:white;}
	
	@media screen and (max-width: 800px) {
	.mt-tcell {  padding: 9px; line-height:100%;  font-size: 13px;  cursor: default;}
	
	}
</style >
<script is:inline>
	const container = document.querySelector('.mt-table-container');
	const resultContainer = document.querySelector('.mt-results');

	if (container && resultContainer) {
		const tableData = [];
		const highlightedCells = new Set();
		const table = document.createElement('table');
		table.className = 'mt-table';

		for (let row = 1; row <= 10; row += 1) {
			const tableRow = document.createElement('tr');
			tableRow.className = 'mt-trow';
			const rowCells = [];

			for (let cell = 1; cell <= 10; cell += 1) {
				const tableCell = document.createElement('td');
				const result = row * cell;
				tableCell.className = 'mt-tcell';
				tableCell.dataset.row = String(row);
				tableCell.dataset.cell = String(cell);
				tableCell.title = String(result);
				tableCell.textContent = String(result);
				tableCell.tabIndex = 0;
				if (cell === row) tableCell.classList.add('is-square');
				tableRow.appendChild(tableCell);
				rowCells.push(tableCell);
			}

			tableData.push(rowCells);
			table.appendChild(tableRow);
		}

		const clearHighlight = () => {
			for (const cell of highlightedCells) {
				cell.classList.remove('is-zone', 'is-zone-border', 'is-result', 'is-data');
			}
			highlightedCells.clear();
		};

		const showResult = (target) => {
			const row = Number(target.dataset.row);
			const cell = Number(target.dataset.cell);
			if (!row || !cell) return;

			clearHighlight();
			resultContainer.textContent = `${row} × ${cell} = ${row * cell}`;
			target.classList.add('is-result');
			tableData[row - 1][0].classList.add('is-data');
			tableData[0][cell - 1].classList.add('is-data');

			for (let rowIndex = 0; rowIndex < row; rowIndex += 1) {
				for (let cellIndex = 0; cellIndex < tableData[rowIndex].length; cellIndex += 1) {
					const currentCell = tableData[rowIndex][cellIndex];
					if (cellIndex < cell) {
						currentCell.classList.add('is-zone');
						if (cellIndex === cell - 1 || rowIndex === row - 1) currentCell.classList.add('is-zone-border');
					}
					highlightedCells.add(currentCell);
				}
			}
		};

		const handleCell = (event) => {
			if (event.target instanceof HTMLElement && event.target.matches('.mt-tcell')) showResult(event.target);
		};

		table.addEventListener('mouseover', handleCell);
		table.addEventListener('focusin', handleCell);
		table.addEventListener('mouseleave', () => {
			resultContainer.textContent = '';
			clearHighlight();
		});
		container.appendChild(table);
	}
</script>

</Layout_main>
