---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
---

<!DOCTYPE html>
<html lang="ru">
<head>
	<SeoHead
		title="Ошибка 404 — страница не найдена"
		description="Такой страницы не существует. Вернитесь на главную страницу Timestable.ru."
		noindex
	/>
</head>
<body>
	<Header />

<style>
body {display:flex; display:flex; justify-content: center; align-items:center; background:#dfe2ed; }
.error404 {text-align:center; background:transparent; padding: 15px;  margin: 0;}
.error404 h1 {font-size:100px;}

@media screen and (max-width: 800px) {
.error404 h1 {font-size:62px;}
.error404 h1 span {font-size:128px;}
}
</style>

<main class="error404">
	<div class="wrapper">
		<div class="">
			<h1>Ошибка <span>404</span></h1>
			<p>Вы зашли на несуществующую страницу или доступ к ней временно закрыт.</p>
			<div class="btnwrap"><a href="/" class="btn">Вернуться на главную</a></div>
		</div>
	</div>
</main>
	<Footer />
</body>
</html>
