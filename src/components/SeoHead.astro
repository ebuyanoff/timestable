---
export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  pageType?: 'website' | 'article';
}

const {
  title,
  description,
  image = '/images/0/ogimg/ogimage-1200x630.png',
  noindex = false,
  pageType = 'article',
} = Astro.props;

const site = Astro.site ?? new URL('https://timestable.ru');
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL(image, site);
const schema = {
  '@context': 'https://schema.org',
  '@type': pageType === 'website' ? 'WebSite' : 'WebPage',
  name: title,
  description,
  url: canonical.href,
  inLanguage: 'ru-RU',
  ...(pageType === 'website' ? {} : { primaryImageOfPage: socialImage.href }),
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Timestable" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:type" content={pageType} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Таблица умножения — Timestable.ru" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="stylesheet" href="/css/style.css?3" />
<link rel="apple-touch-icon" sizes="180x180" href="/images/0/ogimg/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/images/0/ogimg/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/images/0/ogimg/favicon-16x16.png" />
<meta name="yandex-tableau-widget" content="logo=/images/0/ogimg/ya-logo.png, color=#ffffff" />
<meta name="yandex-verification" content="1432afd6992197e2" />
<meta name="yandex-verification" content="573bbd31acf2c6e2" />

{!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
